rules_version = '2';

// All writes in the app go through the Admin SDK, which bypasses these
// rules. They exist as defense-in-depth for any direct client read/write
// via the Firebase Auth session, and as documentation of the intended
// access model. Any time the client paths change, mirror them here.

service cloud.firestore {
  match /databases/{database}/documents {

    // Managers: only the owner can read/write their own tree.
    match /managers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // FCM push tokens: server-side writes via the registerFcmToken action
      // (Admin SDK), but allow client read so a manager can see / clear
      // their own registrations from a future "Devices" UI.
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /groups/{groupId} {
        // A "viewer" is any manager whose UID is listed in this group's
        // viewerUids array. They can read every doc under the group's
        // sub-tree but cannot write — defense-in-depth on top of the
        // server actions which already enforce the same rule.
        function isOwner() { return request.auth != null && request.auth.uid == uid; }
        function isViewer() {
          return request.auth != null
            && resource != null
            && resource.data.viewerUids is list
            && request.auth.uid in resource.data.viewerUids;
        }

        allow read: if isOwner() || isViewer();
        allow write: if isOwner();

        match /athletes/{athleteId} {
          // Look up the parent group's viewerUids via get() so child
          // collections inherit read access without duplicating the array.
          function parentIsViewer() {
            let group = get(/databases/$(database)/documents/managers/$(uid)/groups/$(groupId));
            return request.auth != null
              && group.data.viewerUids is list
              && request.auth.uid in group.data.viewerUids;
          }
          allow read: if isOwner() || parentIsViewer();
          allow write: if isOwner();
        }

        match /campaigns/{campaignId} {
          function parentIsViewer() {
            let group = get(/databases/$(database)/documents/managers/$(uid)/groups/$(groupId));
            return request.auth != null
              && group.data.viewerUids is list
              && request.auth.uid in group.data.viewerUids;
          }
          allow read: if isOwner() || parentIsViewer();
          allow write: if isOwner();

          // Responses: the manager (and now any viewer) can read all
          // responses in their group's campaigns; an athlete may only
          // write their own response document (docId == their uid).
          match /responses/{responseId} {
            function grandparentIsViewer() {
              let group = get(/databases/$(database)/documents/managers/$(uid)/groups/$(groupId));
              return request.auth != null
                && group.data.viewerUids is list
                && request.auth.uid in group.data.viewerUids;
            }
            allow read: if isOwner() || grandparentIsViewer();
            allow write: if request.auth != null && request.auth.uid == responseId;
          }

          match /travelTimes/{cacheId} {
            allow read, write: if isOwner();
          }
        }
      }
    }

    // Athletes: only the athlete can read/write their own encrypted profile.
    match /athletes/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Same fcmTokens pattern as on the manager side.
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Reverse indexes: server-only (Admin SDK). Deny every client read or
    // write — exposing these would let anyone enumerate invite tokens or
    // campaign ids.
    match /inviteIndex/{token} {
      allow read, write: if false;
    }
    match /campaignIndex/{campaignId} {
      allow read, write: if false;
    }
    match /athleteMemberships/{athleteUid} {
      allow read, write: if false;
    }
    // staffShares: server-only. The Admin SDK populates a per-viewer-uid
    // sub-tree pointing at owned groups. Never exposed to clients.
    match /staffShares/{viewerUid}/{document=**} {
      allow read, write: if false;
    }

    // Rate-limit counters: server-only. Clients must never read (would
    // leak usage of other buckets) or write (would let an attacker reset
    // their own counter).
    match /rateLimits/{key} {
      allow read, write: if false;
    }
  }
}
